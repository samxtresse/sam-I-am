# =============================================================================
# Sam-I-am — personal hub (Secretary v1)
# Copy this file to .env.local and fill in real values.
# All integrations fall back to stub data when their keys are missing, so the
# app boots and renders even without any keys.
# =============================================================================

# ---- Public URL ------------------------------------------------------------
APP_URL=http://localhost:3000

# ---- Owner identity (single-tenant) ----------------------------------------
SECRETARY_OWNER_EMAIL=sam@xtresse.com
SECRETARY_OWNER_NAME=Sam

# ---- Cookie-gate password (generate something long & random) ---------------
# openssl rand -base64 32
SECRETARY_AUTH_TOKEN=

# ---- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ---- Supabase (service-role key, server-only) -----------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (Calendar + Gmail) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/secretary/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Slack DM bot (optional) ----------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OWNER_USER_ID=

# ---- Twilio SMS (optional) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_OWNER_NUMBER=

# ---- Notion sync (optional) -----------------------------------------------
NOTION_TOKEN=
NOTION_NOTES_PAGE_ID=
NOTION_TASKS_DB_ID=

# ---- Cron auth -------------------------------------------------------------
CRON_SECRET=
